  #     format: "[title] • [chapter] • [author]"
  #     alt-format: "[author] • [chapter] • [title]"
  #     frontmatter-format: ""
  #     align: left-right
  #     distance-from-edge: 20mm
  #     content-padding-after: 10mm
  #   page-footer:
  #     enabled: true
  #     format: "[page]/[total-pages]"

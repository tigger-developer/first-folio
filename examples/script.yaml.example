# Example script.yaml for First Folio, with an optional Yapper namespace
#
# This file can participate at two scopes:
#   ~/.config/first-folio/script.yaml   (global user defaults)
#   nearest ancestor of the source file  (per-project overrides)
#
# First Folio walks from the source directory towards HOME and uses the nearest
# script.yaml. A script-<style>.yaml sibling is then applied for the active style.
# Per-project values override global values; CLI flags override everything.
#
# First Folio only reads this file — it never modifies or creates it.
#
# Everything below is commented out by default — uncomment only what you
# want to override. Script/letter defaults come from british-script.yaml;
# manuscript defaults come from british-manuscript.yaml. See presets/ for the
# active base and style-override values.

# --- Shared metadata ---
# Override #+TITLE, #+AUTHOR, etc. from the source. Usually leave these
# in the source doc and only set date/version here per-project.
# title: The Glass Orchard
# author: Example Author
# date: "2026-07-06"
# version: "Draft v3"

# --- Shared rendering toggles ---
# Read by both First Folio and yapper.
# render:
#   stage-directions: true
#   frontmatter: true
#   footnotes: true
#   character-table: true
#   transitions: true

# --- First Folio PDF rendering ---
# folio:
#   font: Libertinus Serif       # any installed font; e.g. EB Garamond, Asap
#   font-size: 12pt
#   heading-font: Libertinus Sans
#   heading-font-size: 14pt
#   font-weight: regular         # optional: thin, light, regular, bold, black, or 100-900
#   font-stretch: 100%           # optional: 75%, 100%, 125% — pin a variant (e.g. avoid Asap Condensed fallback)
#   margin: 25mm
#   page: a4                     # or us-letter
#   default-format: pdf

  # --- Title page ---
  # title-page:
  #   page-number: false
  #   title:
  #     align: center            # left | center | right
  #     font-size: 24pt
  #     bold: true
  #     italic: false
  #     case-transform: as-written   # upper | lower | as-written | small-caps
  #     position: third          # third | top | center | bottom
  #     space-before: 0
  #   subtitle:
  #     align: center
  #     font-size: 14pt
  #     italic: true
  #     space-before: 1em
  #   author:
  #     align: center
  #     prefix: "by "
  #     space-before: 2em
  #   date:
  #     position: bottom-left
  #     font-size: 10pt
  #   version:
  #     position: bottom-right
  #     font-size: 10pt

  # --- Per-element positioning ---
  # positioning:
  #   speech:
  #     space-before: 1.6em
  #     speaker:
  #       case-transform: upper        # how speaker name appears
  #       suffix: ":"                  # or "" for new-line style
  #       bold: true
  #     dialogue:
  #       placement: same-line         # same-line | new-line
  #       wrap-indent: 7em
  #     speech-instruction:
  #       prefix: "("
  #       suffix: ")"
  #       italic: true
  #
  #   stage-direction:
  #     italic: true
  #     space-before: 1.6em
  #
  #   transition:
  #     align: right
  #     case-transform: upper
  #     space-before: 1.6em
  #
  #   act-header:
  #     align: center
  #     bold: true
  #     page-break-before: true
  #
  #   scene-header:
  #     align: left
  #     bold: true
  #     space-before: 2em

  # --- Cover letter rendering (folio letter) ---
  # letter:
  #   font: Libertinus Serif       # may differ from script body font
  #   font-size: 11pt
  #   font-weight: regular         # optional: thin, light, regular, bold, black, or 100-900
  #   font-stretch: 100%           # optional: pin a variant (e.g. avoid Asap Condensed fallback)
  #   page: a4
  #   margin-top: 25mm
  #   margin-bottom: 25mm
  #   margin-left: 30mm
  #   margin-right: 25mm
  #   space-after-sender: 2em
  #   space-after-recipient: 1em
  #   space-after-date: 1em
  #   space-after-subject: 0.5em
  #   space-before-closing: 0.8em
  #   space-before-signoff: 1.5em

  # --- Prose manuscript rendering (folio manuscript) ---
  # manuscript:
  #   style: british              # british | us
  #   page: a4
  #   margin: 20mm
  #   gutter: 0mm
  #   font: Libertinus Serif
  #   font-size: 12pt
  #   font-weight: regular
  #   heading-font: Libertinus Sans
  #   heading-font-size: 14pt
  #   heading-font-weight: regular
  #   mono-font: Libertinus Mono
  #   mono-font-size: 10pt
  #   mono-font-weight: regular
  #   line-spacing: 1.5
  #   justify: true
  #   widow-orphan-control: true
  #   paragraph-indent: 10mm
  #   paragraph-spacing: 0
  #   date-format: "2 January 2006"
  #   title-page:

// ABOUTME: Typst layout template for stage-play PDF and Typst output.
// ABOUTME: Receives validated layout values and escaped semantic body markup from Go.
// Generated by First Folio
#set page(paper: "{{.Page}}", margin: {{.Margin}}, numbering: "1", number-align: center + bottom)
#set text({{.RootFont.Args}})
#set par(leading: 0.6em)

#let folio-font-role = state("folio-font-role", "role")
#let folio-font-stretch(ratio, body, role: "role") = {
  if ratio == 100% {
    body
  } else {
    folio-font-role.update(role)
    set text(stretch: 100%, spacing: ratio)
    show regex("\\S+"): word => context {
      if folio-font-role.at(here()) != role {
        word
      } else {
        let descent = measure(text(top-edge: "baseline", word)).height
        box(baseline: descent, scale(x: ratio, y: 100%, reflow: true, word))
      }
    }
    body
    folio-font-role.update("role")
  }
}

#let root-text(body) = text({{.RootFont.Args}})[#folio-font-stretch({{.RootFont.Stretch}}, body)]
#let mono-text(body) = text({{.MonoFont.Args}})[#folio-font-stretch({{.MonoFont.Stretch}}, body, role: "mono")]
#let frontmatter-paragraph(body) = text({{.FrontmatterParagraphFont.Args}})[#folio-font-stretch({{.FrontmatterParagraphFont.Stretch}}, body)]
#show heading: it => text({{.HeadingFont.Args}})[#folio-font-stretch({{.HeadingFont.Stretch}}, it)]

{{if .DialogueSameLine}}
#let dialogue(name, direction: none, body) = {
  block(above: {{.SpeechSpace}}, below: 0.2em, breakable: true)[
    #grid(
      columns: ({{.DialogueWrap}}, 1fr),
      gutter: 0pt,
      [#text({{.SpeakerFont.Args}})[#folio-font-stretch({{.SpeakerFont.Stretch}})[{{.SpeakerContent}}]]],
      [
        #if direction != none [
          #text({{.InstructionFont.Args}})[#folio-font-stretch({{.InstructionFont.Stretch}})[{{.InstructionPrefix}}#direction{{.InstructionSuffix}}]] \
        ]
        #text({{.DialogueFont.Args}})[#folio-font-stretch({{.DialogueFont.Stretch}}, body)]
      ],
    )
  ]
}
{{else}}
#let dialogue(name, direction: none, body) = {
  block(width: 100%, above: {{.SpeechSpace}}, below: 0.2em, breakable: true, spacing: 0em)[
    #set par(spacing: 0.6em)
    #pad(left: {{.DialogueIndent}}, right: {{.DialogueWrap}})[
      #pad(left: {{.SpeakerIndent}})[#align({{.SpeakerAlign}})[#text({{.SpeakerFont.Args}})[#folio-font-stretch({{.SpeakerFont.Stretch}})[{{.SpeakerContent}}]]{{if .InstructionInline}}#if direction != none [ #text({{.InstructionFont.Args}})[#folio-font-stretch({{.InstructionFont.Stretch}})[{{.InstructionPrefix}}#direction{{.InstructionSuffix}}]]]{{end}}]]
      {{if not .InstructionInline}}#if direction != none [
        #align({{.InstructionAlign}})[#text({{.InstructionFont.Args}})[#folio-font-stretch({{.InstructionFont.Stretch}})[{{.InstructionPrefix}}#direction{{.InstructionSuffix}}]]]
      ]{{end}}
      #text({{.DialogueFont.Args}})[#folio-font-stretch({{.DialogueFont.Stretch}}, body)]
    ]
  ]
}
{{end}}

#let stage-direction(body) = {
  block(width: 100%, above: {{.DirectionSpace}}, below: 0.6em)[
    #pad(left: {{.DirectionIndent}})[#align({{.DirectionAlign}})[#text({{.DirectionFont.Args}})[#folio-font-stretch({{.DirectionFont.Stretch}})[{{.DirectionOpen}}#body{{.DirectionClose}}]]]]
  ]
}

#let transition(body) = {
  v({{.TransitionSpace}})
  pad(left: {{.TransitionIndent}})[#align({{.TransitionAlign}})[#text({{.TransitionFont.Args}})[#folio-font-stretch({{.TransitionFont.Stretch}}, body)]]]
}

#let act-header(title) = {
  v({{.ActSpace}})
  align({{.ActAlign}})[#text({{.ActFont.Args}})[#folio-font-stretch({{.ActFont.Stretch}})[{{.ActOpen}}#title{{.ActClose}}]]]
  v(0.3em)
}

#let scene-header(title) = {
  v({{.SceneSpace}})
  align({{.SceneAlign}})[#text({{.SceneFont.Args}})[#folio-font-stretch({{.SceneFont.Stretch}})[{{.SceneOpen}}#title{{.SceneClose}}]]]
  v({{.SceneAfter}})
}

#let frontmatter-header(title) = {
  v({{.FrontmatterSpace}})
  align({{.FrontmatterAlign}})[#text({{.FrontmatterFont.Args}})[#folio-font-stretch({{.FrontmatterFont.Stretch}}, title)]]
}

#let prop-text(body) = {
  v(1.6em)
  align(center)[#text(style: "italic", weight: "bold")[#folio-font-stretch({{.RootFont.Stretch}}, body)]]
  v(0.6em)
}

{{if .RunningHeader.Enabled}}
#let running-header = context {
  let pg = counter(page).get().first()
  let first-body = state("folio-script-body-page", 0).final()
  let is-body = first-body > 0 and pg >= first-body
  {{if and .TitleSkipHeader (or (not .TitlePageEnabled) .HasTitle)}}if pg != 1 { {{end}}
  align({{.RunningHeader.Align}})[#text({{.RunningHeader.Font.Args}})[#folio-font-stretch({{.RunningHeader.Font.Stretch}})[{{.RunningHeader.Format}}]]]
  {{if and .TitleSkipHeader (or (not .TitlePageEnabled) .HasTitle)}}}{{end}}
}
{{end}}
{{if .RunningFooter.Enabled}}
#let running-footer = context {
  let pg = counter(page).get().first()
  let first-body = state("folio-script-body-page", 0).final()
  let is-body = first-body > 0 and pg >= first-body
  {{if and .TitleSkipFooter (or (not .TitlePageEnabled) .HasTitle)}}if pg != 1 { {{end}}
  align({{.RunningFooter.Align}})[#text({{.RunningFooter.Font.Args}})[#folio-font-stretch({{.RunningFooter.Font.Stretch}})[{{.RunningFooter.Format}}]]]
  {{if and .TitleSkipFooter (or (not .TitlePageEnabled) .HasTitle)}}}{{end}}
}
{{end}}

{{if and .TitlePageEnabled .HasTitle}}
#set page(numbering: {{if .TitlePageNumber}}"1"{{else}}none{{end}},
  header: {{if .RunningHeader.Enabled}}running-header{{else}}none{{end}},
  {{if and .RunningFooter.Enabled (not .TitleSkipFooter)}}footer-descent: 0pt,{{end}}
  footer: [
{{if and .RunningFooter.Enabled (not .TitleSkipFooter)}}#running-footer
#linebreak(){{end}}
#grid(
  columns: (1fr, 1fr),
  align: (left, right),
  [{{.FooterLeft}}],
  [{{.FooterRight}}],
)])
{{template "title-block" .}}
#pagebreak()
{{end}}

#set page(
  numbering: none,
  margin: (
    top: {{if .RunningHeader.Enabled}}{{.RunningHeader.DistanceFromEdge}} + {{.RunningHeader.ContentPaddingAfter}}{{else}}{{.Margin}}{{end}},
    bottom: {{if .RunningFooter.Enabled}}{{.RunningFooter.DistanceFromEdge}} + {{.RunningFooter.ContentPaddingAfter}}{{else}}{{.Margin}}{{end}},
    rest: {{.Margin}},
  ),
  {{if .RunningHeader.Enabled}}header-ascent: {{.RunningHeader.ContentPaddingAfter}},{{end}}
  {{if .RunningFooter.Enabled}}footer-descent: {{.RunningFooter.ContentPaddingAfter}},{{end}}
  header: {{if .RunningHeader.Enabled}}running-header{{else}}none{{end}},
  footer: {{if .RunningFooter.Enabled}}running-footer{{else}}none{{end}},
)

{{if not .TitlePageEnabled}}
{{template "title-block" .}}
{{if or .FooterLeft .FooterRight}}
#grid(columns: (1fr, 1fr), align: (left, right),
  [{{.FooterLeft}}], [{{.FooterRight}}],
)
{{end}}
{{end}}

{{.Body}}

{{define "title-block"}}
#align({{.TitleAlign}})[
  {{if .TitlePageEnabled}}#v({{.TitleOffset}}){{end}}
  {{if .HasTitle}}#text({{.TitleFont.Args}})[#folio-font-stretch({{.TitleFont.Stretch}})[{{.Title}}]]{{end}}
  {{if .HasSubtitle}}
  #v({{.SubtitleSpace}})
  #text({{.SubtitleFont.Args}})[#folio-font-stretch({{.SubtitleFont.Stretch}})[{{.Subtitle}}]]
  {{end}}
  {{if .HasAuthor}}
  {{if .AuthorPrefixLines}}
  #v({{.AuthorSpace}})
  {{range $index, $line := .AuthorPrefixLines}}
  {{if $index}}#v(0.3em){{end}}
  #text({{$.AuthorFont.Args}})[#folio-font-stretch({{$.AuthorFont.Stretch}})[{{$line}}]]
  {{end}}
  #v(0.3em)
  #text({{.AuthorFont.Args}})[#folio-font-stretch({{.AuthorFont.Stretch}})[{{.Author}}]]
  {{else}}
  #v({{.AuthorSpace}})
  #text({{.AuthorFont.Args}})[#folio-font-stretch({{.AuthorFont.Stretch}})[{{.AuthorPrefixInline}}{{.Author}}]]
  {{end}}
  {{end}}
]
{{end}}
